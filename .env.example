# ApplicationからAgent Routerへの接続
AGENT_ROUTER_BASE_URL=http://127.0.0.1:1975
AGENT_ROUTER_API_KEY=unused

# Task Router
TASK_ROUTER_MODE=dummy
TASK_ROUTER_DEFAULT_MODEL=qwen3.8-27b-exl3-3.5bpw-wm

# Agent Routerからllama-serverへの接続
LLAMA_SERVER_BASE_URL=http://127.0.0.1:2067
LLAMA_SERVER_API_KEY=sk-local-no-key-required

# モデル
LLM_MODEL=qwen3.8-27b-exl3-3.5bpw-wm
LLM_DEFAULT_REQUEST_MODEL=Auto
LLM_API_STYLE=chat_completions

# 生成パラメータ（空欄はthinkingモードの既定値を使用）
LLAMA_SERVER_ENABLE_THINKING=false
LLAMA_SERVER_TEMPERATURE=0.3
LLAMA_SERVER_TOP_P=
LLAMA_SERVER_TOP_K=
LLAMA_SERVER_MIN_P=
LLAMA_SERVER_MAX_TOKENS=1000

# Application側の接続信頼性
LLAMA_SERVER_TIMEOUT_SECONDS=15
LLAMA_SERVER_MAX_RETRIES=3
LLAMA_SERVER_RETRY_BASE_SECONDS=0.8
LLAMA_SERVER_RETRY_MAX_SECONDS=8.0

# Opik
OPIK_ENABLED=true
OPIK_BASE_URL=http://127.0.0.1:5181
OPIK_PROJECT_NAME=agent-router-local
OPIK_NGINX_PORT=5181
# 公式Opikリポジトリの配置先。未指定時は$HOME/opik。
OPIK_REPO_DIR=

# Agent RouterからOpikへのOpenTelemetry（OpikはHTTP/protobufのみ）
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:5181/api/v1/private/otel/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=projectName=agent-router-local

# Agent RouterのLLMトレース
AI_GATEWAY_TRACING_SEMCONV=openinference
OPENINFERENCE_HIDE_INPUTS=false
OPENINFERENCE_HIDE_OUTPUTS=false

# Agent RouterのAdmin endpoint
AGENT_ROUTER_ADMIN_BASE_URL=http://127.0.0.1:1064
